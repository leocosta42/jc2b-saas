# ========================================
# SUPABASE Configuration
# ========================================
# Obter em: https://app.supabase.com/projects

# URL do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon (pública, segura para cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-anon-key-aqui

# Chave service role (SECRET - nunca commit!)
# Use apenas no servidor
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui

# ========================================
# Application Configuration
# ========================================

# URL do site (usado para links e redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ========================================
# Integrations (Opcional)
# ========================================

# Melhor Envio (cálculo de frete)
# Obter em: https://melhorenvio.com.br
# Deixar em branco se não usar
MELHOR_ENVIO_TOKEN=seu-token-melhor-envio

# ========================================
# Security Configuration (Automático)
# ========================================
# Esses valores são configurados automaticamente
# no middleware e não precisam ser alterados

# CSP (Content Security Policy)
# Status: ATIVO em produção, REPORT-ONLY em desenvolvimento

# CORS (Cross-Origin Resource Sharing)
# Domínios permitidos configurados em:
# src/lib/supabase/middleware.ts

# ========================================
# Development Configuration
# ========================================

# NODE_ENV é configurado automaticamente por:
# - npm run dev   → development
# - npm run build → production
# Não altere manualmente

# ========================================
# SETUP INSTRUCTIONS
# ========================================
#
# 1. Copie este arquivo:
#    cp .env.example .env.local
#
# 2. Preencha seus valores reais em .env.local:
#    NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
#    NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
#    SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
#    NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
#
# 3. Nunca commit de .env.local (git ignora automaticamente)
#
# 4. Inicie o servidor:
#    npm run dev
#
# ========================================
# IMPORTANTE - SEGURANÇA
# ========================================
#
# ⚠️  NUNCA faça commit de .env.local
# ⚠️  NUNCA compartilhe suas chaves
# ⚠️  NUNCA coloque chaves em comentários de código
# ⚠️  NUNCA exponha SUPABASE_SERVICE_ROLE_KEY no cliente
#
# Chaves vazadas = acesso total ao banco de dados
# Se vazar, regenere imediatamente no Supabase Dashboard
#
# ========================================
